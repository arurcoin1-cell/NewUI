    textLabel.Font = Enum.Font.SourceSansBold
    textLabel.TextSize = 18
    textLabel.TextXAlignment = Enum.TextXAlignment.Left
    textLabel.Parent = background
    textLabel.ZIndex = 1402

    local tweenIn = tween_service:Create(notifHolder, TweenInfo.new(0.2), {Position = UDim2.new(1, -310, 1, -75 - (#notifications * 35))})
    tweenIn:Play()

    table.insert(notifications, notifHolder)

    local function removeNotification()
        local tweenOut = tween_service:Create(notifHolder, TweenInfo.new(0.25), {Position = UDim2.new(1, 310, 1, notifHolder.Position.Y.Offset)})
        tweenOut:Play()
        tweenOut.Completed:Wait()
        notifHolder:Destroy()

        for i, v in ipairs(notifications) do
            if v == notifHolder then
                table.remove(notifications, i)
                break
            end
        end

        for i, notif in ipairs(notifications) do
            tween_service:Create(notif, TweenInfo.new(0.15), {Position = UDim2.new(1, -310, 1, -75 - ((i - 1) * 35))}):Play()
        end
    end

    task.delay(time, removeNotification)
end

