ArurHubData.dunkRemoteCache = {}
function ArurHubData.updateDunkCache()
    ArurHubData.dunkRemoteCache = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "dunkFunction" and obj.Parent and obj.Parent:IsA("BasePart") then
            table.insert(ArurHubData.dunkRemoteCache, obj)
        end
    end
end
ArurHubData.updateDunkCache()

workspace.DescendantAdded:Connect(function(obj)
    if obj.Name == "dunkFunction" then task.wait(1); ArurHubData.updateDunkCache() end
end)

function ArurHubData.HasBall(targetPlayer)
    local char = (targetPlayer or lp).Character
    if not char then return false end
    if char:FindFirstChild("Basketball") or char:FindFirstChild("basketball") then return true end
    for _, obj in ipairs(char:GetChildren()) do
        if string.match(string.lower(obj.Name), "basketball") then return true end
    end
    return false
end

function ArurHubData.findTheBall()
    local char = lp.Character
    if not char then return nil end
    local ballInChar = char:FindFirstChild("Basketball") or char:FindFirstChild("Ball")
    if ballInChar then
        for _, obj in ipairs(workspace:GetChildren()) do
            if obj.Name == "Basketball" and obj ~= char then
                local p = obj:FindFirstChildOfClass("BasePart") or (obj:IsA("BasePart") and obj)
                if p and (p.Position - char.HumanoidRootPart.Position).Magnitude < 10 then
                    return obj 
                end
            end
        end
        return ballInChar
    end
    return nil
end

task.spawn(function()
    while task.wait(0.1) do
        if not ArurHubData.AutoDunkEnabled or ArurHubData.IsDunkingSpam then continue end
        
        local char = lp.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then continue end

        local ball = ArurHubData.findTheBall()
        if not ball then continue end

        local nearestRemote, nearestDist = nil, math.huge
        local flatPlayer = Vector2.new(root.Position.X, root.Position.Z)

        -- FAST LOOKUP: Iterate ONLY the cached remotes (Usually 2-4 per map)
        for _, obj in ipairs(ArurHubData.dunkRemoteCache) do
            local hoopPart = obj.Parent
            if hoopPart then
                local flatHoop = Vector2.new(hoopPart.Position.X, hoopPart.Position.Z)
                local dist = (flatPlayer - flatHoop).Magnitude
                
                if dist < nearestDist then
                    nearestDist = dist
                    nearestRemote = obj
                end
            end
        end

        if nearestRemote and nearestDist <= 21.0 then
            ArurHubData.IsDunkingSpam = true
            task.spawn(function()
                while hasBall() and ArurHubData.AutoDunkEnabled do
                    task.spawn(function()
                        nearestRemote:InvokeServer(ball)
                    end)
                    task.wait(0.05)
                end
                task.wait(1.5)
                ArurHubData.IsDunkingSpam = false
            end)
        end
    end
end)
