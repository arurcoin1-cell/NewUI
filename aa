local lockAccum = 0
local FOLLOW_DIST = 1.5  -- How close to stick (studs)
local DEAD_ZONE   = 1.0  -- Only re-issue MoveTo outside this tolerance

run_service.Heartbeat:Connect(function(dt)
    if not ArurHubData.LockToPlayer then 
        if isTargetHUDVisible then animateTargetHUD(false) end
        return 
    end
    lockAccum = lockAccum + dt
    if lockAccum < 0.05 then return end -- ~20fps cap
    lockAccum = 0

    local myChar = lp.Character
    local rPart = pRoot
    local activeHum = pHum

    local function disableLock()
        ArurHubData.LockToPlayer = false
        ArurHubData.LockedPlayer = nil
        animateTargetHUD(false)
        if not sync_guards.lock then
            sync_guards.lock = true
            if lock_toggle then lock_toggle.set(false) end
            if lock_keybind then lock_keybind.set(false) end
            sync_guards.lock = false
        end
    end

    if ArurHubData.HasBall() then
        disableLock()
    elseif ArurHubData.LockedPlayer and ArurHubData.LockedPlayer.Character then
        local tRoot = ArurHubData.LockedPlayer.Character:FindFirstChild("HumanoidRootPart")
        if tRoot and rPart and activeHum then
            local myPos    = rPart.Position
            local tPosReal = tRoot.Position
            local realDist = (Vector3.new(myPos.X, 0, myPos.Z) - Vector3.new(tPosReal.X, 0, tPosReal.Z)).Magnitude
            local scaler   = math.clamp(realDist / 6, 0.1, 1) -- Prediction starts dropping at 6 studs
            local tPos     = tPosReal + (tRoot.Velocity * ArurHubData.PredictionOffset * scaler)
            local dist     = (Vector2.new(myPos.X, myPos.Z) - Vector2.new(tPos.X, tPos.Z)).Magnitude

            -- HUD UPDATE
            if ArurHubData.TargetHUDEnabled then
                updateTargetHUD(ArurHubData.LockedPlayer, realDist)
            else
                animateTargetHUD(false)
            end

            if math.abs(dist - FOLLOW_DIST) > DEAD_ZONE then
                local dest = tPos + (tRoot.Velocity.Magnitude > 0.1 and tRoot.Velocity.Unit * FOLLOW_DIST or Vector3.zero)
                activeHum:MoveTo(dest)
            end
        end
    else
        disableLock()
    end
end)

